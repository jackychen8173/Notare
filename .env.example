# Copy to .env (or export these in your shell / Railway project settings).
# .env is gitignored — never commit real values.

# Database (Railway Postgres in prod, local Postgres in dev)
DATABASE_URL=jdbc:postgresql://localhost:5432/notare
DATABASE_USERNAME=notare
DATABASE_PASSWORD=changeme

# JWT signing secret — must be at least 32 random characters (HS256 requires a >=256-bit key)
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRATION_MS=86400000

# Sign in with Google — the OAuth 2.0 Client ID from Google Cloud Console (same value the frontend
# uses as NEXT_PUBLIC_GOOGLE_CLIENT_ID). Verifies a Google ID token was actually issued for this
# app, not some other one.
GOOGLE_OAUTH_CLIENT_ID=

# Server
PORT=8080

# CORS — comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Sage (Anthropic) — read directly by the Anthropic Java SDK (AnthropicOkHttpClient.fromEnv())
ANTHROPIC_API_KEY=

# Code execution ("Run" on a coding assignment) — the backend calls the Next.js /api/code-run
# route (which actually talks to Vercel Sandbox), not Vercel directly. CODE_RUN_INTERNAL_SECRET
# must match the same value set on the Vercel project - it's how that route tells a legitimate
# backend call apart from an open internet request.
CODE_RUN_SERVICE_URL=http://localhost:3000
CODE_RUN_INTERNAL_SECRET=
