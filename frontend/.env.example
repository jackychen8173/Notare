# Copy to .env.local (gitignored — never commit real values).

# Base URL of the Notare Spring Boot API
NEXT_PUBLIC_API_URL=http://localhost:8080

# Sign in with Google — the OAuth 2.0 Client ID from Google Cloud Console (same value the backend
# uses as GOOGLE_OAUTH_CLIENT_ID). Public by design — client IDs aren't secrets, Google's
# Authorized JavaScript origins list is what actually restricts where this can be used from.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Set to true once the backend can send email (RESEND_API_KEY plus a verified sending domain).
# Until then the "Forgot password?" link and the confirm-email notice stay hidden.
NEXT_PUBLIC_EMAIL_ENABLED=false
